<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 全网搜索入口 Header -->
            <LinearLayout
                android:id="@+id/btnSearchHeader"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_episode_normal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="全网搜索海量影视资源..."
                    android:textColor="#999999"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 2. 顶部分类 Tag 导航 Tab -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:tabMode="scrollable"
                app:tabGravity="start"
                app:tabIndicatorColor="#FF6200EE"
                app:tabSelectedTextColor="#FF6200EE"
                app:tabTextColor="#666666" />

            <!-- 3. 顶部强推轮播图 ViewPager2 -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerBanner"
                android:layout_width="match_parent"
                android:layout_height="196dp"
                android:layout_marginBottom="4dp" />

            <!-- 4. 三列原生海报墙网格 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMovieGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:padding="8dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>